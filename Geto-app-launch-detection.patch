diff --git a/launch-monitor/src/main/kotlin/com/android/geto/launchmonitor/AppLaunchDetectionSetup.kt b/launch-monitor/src/main/kotlin/com/android/geto/launchmonitor/AppLaunchDetectionSetup.kt
