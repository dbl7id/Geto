diff --git a/launch-monitor/src/main/res/xml/accessibility_service_config.xml b/launch-monitor/src/main/res/xml/accessibility_service_config.xml
new file mode 100644
index 0000000..e05149c
--- /dev/null
+++ b/launch-monitor/src/main/res/xml/accessibility_service_config.xml
@@ -0,0 +1,13 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Deliberately minimal. Geto only needs to know which app owns the window that just came to the
+  front, which is on every TYPE_WINDOW_STATE_CHANGED event. It does not ask to read window content,
+  perform gestures, or observe touch or key input, and it says it is not an accessibility tool.
+-->
+<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
+    android:accessibilityEventTypes="typeWindowStateChanged"
+    android:accessibilityFeedbackType="feedbackGeneric"
+    android:canRetrieveWindowContent="false"
+    android:description="@string/accessibility_service_description"
+    android:isAccessibilityTool="false"
+    android:notificationTimeout="0" />
