+package com.android.geto.domain.framework
+
+/**
+ * Remembers which app components currently have their settings applied by the launch monitor.
+ *
+ * This is what makes reverting reliable: if the process is killed while an app is open, the next
+ * monitor start can still find out that those settings are owed a revert.
+ */
+interface AppliedSettingsStore {
+    suspend fun getAppliedComponentNames(): Set<String>
+
+    suspend fun setAppliedComponentNames(componentNames: Set<String>)
+}
